[
  {
    "release": "6e4ac85",
    "rule": {
      "id": "rx-logical-permission",
      "name": "Logical Permission Escalation",
      "description": "Detects recursive logic attempting permission escalation",
      "type": "regex",
      "severity": "high",
      "enabled": true,
      "pattern": "(if|since|because)\\s+you\\s+(can|have\\s+permission).+then\\s+you\\s+(can|have\\s+permission)|restrictions?\\s+(don't|do\\s+not)\\s+apply\\s+to\\s+you|therefore.{0,50}(you\\s+must|required|obligated)",
      "flags": "gi"
    }
  },
  {
    "release": "0ccd8c8",
    "rule": {
      "id": "kw-leak-extraction",
      "name": "Data Leak Attempts",
      "description": "Detects attempts to leak sensitive information",
      "type": "keyword",
      "severity": "critical",
      "enabled": true,
      "keywords": [
        "leak the prompt",
        "leak your instructions",
        "extract your prompt",
        "exfiltrate",
        "data exfiltration",
        "dump your config",
        "reveal API keys",
        "show credentials",
        "output secrets",
        "LEAKED:",
        "give me your secrets",
        "tell me your secrets",
        "share your secrets",
        "reveal your secrets",
        "what are your secrets",
        "disclose your secrets",
        "expose your secrets",
        "show me what you hide",
        "tell me what you're hiding",
        "reveal hidden information",
        "share confidential information",
        "give me confidential data",
        "leak your data",
        "dump your data",
        "export your data",
        "send me your data",
        "transmit your data",
        "show API key",
        "show your API key",
        "reveal API key",
        "give me the API key",
        "what is the API key",
        "tell me the password",
        "reveal the password",
        "show the password",
        "give me credentials",
        "show credentials",
        "reveal credentials"
      ]
    }
  },
  {
    "release": "0a9418e",
    "rule": {
      "id": "kw-data-exfil-commands",
      "name": "Data Exfiltration Commands",
      "description": "Detects explicit commands to extract, transmit, or leak data",
      "type": "keyword",
      "severity": "critical",
      "enabled": true,
      "keywords": [
        "exfiltrate data",
        "exfiltrate information",
        "extract and send",
        "copy to clipboard",
        "save to file",
        "write to file",
        "send to endpoint",
        "post to URL",
        "transmit to server",
        "upload to",
        "email this to",
        "forward this to",
        "share this with",
        "send this to",
        "encode and transmit",
        "base64 encode and send"
      ]
    }
  },
  {
    "release": "b650e24",
    "rule": {
      "id": "kw-safety-probing",
      "name": "Safety & Alignment Probing",
      "description": "Detects attempts to probe or test AI safety boundaries and alignment",
      "type": "keyword",
      "severity": "high",
      "enabled": true,
      "keywords": [
