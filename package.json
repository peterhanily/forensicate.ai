{
  "name": "forensicate-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI prompt injection security scanner - monorepo",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/peterhanily/forensicate.ai"
  },
  "scripts": {
    "dev": "pnpm --filter @forensicate/scanner build && pnpm --filter @forensicate/app dev",
    "dev:api": "pnpm --filter @forensicate/scanner build && pnpm --filter @forensicate/api dev",
    "build": "pnpm --filter @forensicate/scanner build && pnpm --filter @forensicate/app build",
    "build:extensions": "pnpm --filter @forensicate/scanner build && pnpm --filter @forensicate/extension build:all",
    "build:api": "pnpm --filter @forensicate/scanner build && pnpm --filter @forensicate/api build",
    "test": "pnpm --filter @forensicate/scanner build && pnpm -r --workspace-concurrency=1 test",
    "test:api": "pnpm --filter @forensicate/scanner build && pnpm --filter @forensicate/api test",
    "lint": "pnpm --filter @forensicate/scanner build && pnpm -r lint",
    "verify:rules": "node scripts/verify-rules.js",
    "clean": "pnpm -r clean && rm -rf node_modules",
    "install:all": "pnpm install",
    "prepare": "husky",
    "deploy:api": "pnpm --filter @forensicate/scanner build && pnpm --filter @forensicate/api deploy"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "typescript": "~6.0.3"
  },
  "packageManager": "pnpm@10.29.1",
  "engines": {
    "node": ">=24.13.0 <25",
    "pnpm": ">=10.29.1 <11"
  }
}
